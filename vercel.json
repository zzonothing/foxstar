{
  "rewrites": [
    { "source": "/data/member.js",    "destination": "/api/data?file=member.js"    },
    { "source": "/data/raid.js",      "destination": "/api/data?file=raid.js"      },
    { "source": "/data/character.js", "destination": "/api/data?file=character.js" },
    { "source": "/data/solo.js",      "destination": "/api/data?file=solo.js"      },
    { "source": "/data/notice.js",    "destination": "/api/data?file=notice.js"    },
    { "source": "/data/sim/meta.json",                    "destination": "/api/sim?file=meta.json"           },
    { "source": "/data/sim/union.json",                   "destination": "/api/sim?file=union.json"          },
    { "source": "/data/sim/detail/:uid.json",             "destination": "/api/sim?file=detail/:uid.json"    }
  ],
  "functions": {
    "api/data.js": {
      "includeFiles": "api/_data/**"
    },
    "api/sim.js": {
      "includeFiles": "api/_data/sim/**"
    }
  },
  "headers": [
    {
      "source": "/css/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=3600" }]
    },
    {
      "source": "/js/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=3600" }]
    },
    {
      "source": "/image/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    }
  ]
}
